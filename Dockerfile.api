# ==============================================================================
# PALEGIC SIH 2026 — FastAPI Python Backend Production Container
# ==============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install system dependencies required for geospatial C-libraries and PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libgeos-dev \
    libproj-dev \
    gdal-bin \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml, requirements.txt, and source tree
COPY pyproject.toml requirements.txt ./
COPY api/ ./api/
COPY scripts/ ./scripts/
COPY data/ ./data/

# Install python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

EXPOSE 8100

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=5s \
    CMD curl -f http://127.0.0.1:8100/api/health || exit 1

CMD ["uvicorn", "pelagic.main:app", "--app-dir", "api", "--host", "0.0.0.0", "--port", "8100", "--workers", "2"]
