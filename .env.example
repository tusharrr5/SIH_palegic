# ==============================================================================
# PALEGIC SIH 2026 — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# IMPORTANT:
# Replace all placeholder values with secure, randomly generated secrets.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Database Configuration (PostgreSQL 17 + PostGIS 3.5)
POSTGRES_USER=pelagic
POSTGRES_PASSWORD=CHANGE_TO_A_SECURE_RANDOM_PASSWORD
POSTGRES_DB=maritime_oil_v2
DATABASE_URL=postgresql://pelagic:CHANGE_TO_A_SECURE_RANDOM_PASSWORD@db:5432/maritime_oil_v2

# API & Security
SECRET_KEY=CHANGE_TO_A_RANDOM_64_CHAR_HEX_SECRET
ORIGIN=https://your-production-domain.com
APP_ORIGIN=https://your-production-domain.com
COOKIE_SECURE=true
ENVIRONMENT=production

# Frontend Service Configuration
API_URL=http://api:8100
NODE_ENV=production
PORT=3100
